{
    "name": "FDA product verification extension",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Real time fda verification on online marketplace",
    "permissions": ["tabs", "webNavigation","scripting"],
    "host_permissions": [
        "https://*.shopee.ph/*",
        "https://*.lazada.com.ph/*",
        "https://*.tiktok.com/*",
        "https://*.facebook.com/*"
    ],
    "background" : {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.shopee.ph/*",
                "https://*.lazada.com.ph/*",
                "https://*.tiktok.com/*",
                "https://*.facebook.com/*"
            ],
            "js": ["content.js"]
        }
    ],
    "action": {

        "default_title": "eVerifyMo",
        "default_popup": "popup.html"
    }
}